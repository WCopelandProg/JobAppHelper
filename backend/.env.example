# PostgreSQL connection string
DATABASE_URL="postgresql://jobapphelper:jobapphelper@localhost:5432/jobapphelper?schema=public"

# App
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cover letter generation (optional).
# If unset, the app falls back to a high-quality template-based generator.
ANTHROPIC_API_KEY=

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Job provider sync
JOB_SYNC_CRON="0 * * * *"
JOB_SYNC_ON_BOOT=true
